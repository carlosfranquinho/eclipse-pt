---
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import EtiquetaTipo from "../../components/EtiquetaTipo.astro";
import Mapa from "../../components/Mapa.astro";
import SimulacaoSol from "../../components/SimulacaoSol.astro";
import { t } from "../../i18n";
import {
  NOMES_TERRITORIO,
  NOMES_TIPO,
  NOMES_TIPO_LOCAL,
  dataPorExtenso,
  dataVigente,
  duracao,
  graus,
  horaCurta,
  magnitude,
  numero,
  percentagem,
  rotuloSistemaHora,
  titulo as tituloEclipse,
} from "../../lib/formatacao";
import {
  eclipse as lerEclipse,
  indice,
  metadadosFaixa,
  municipios as lerMunicipios,
  niveisIsomagnitude,
  recursos as lerRecursos,
  vizinhos,
} from "../../lib/dados";
import { TERRITORIOS } from "../../lib/territorios";
import { caminho, urlEclipse } from "../../lib/urls";

export function getStaticPaths() {
  return indice().map((entrada) => ({ params: { id: entrada.id } }));
}

const { id } = Astro.params;
const eclipse = lerEclipse(id!);
const recursos = lerRecursos(eclipse.id);
const municipios = lerMunicipios(eclipse.id);
const faixa = metadadosFaixa(eclipse.id);
const niveis = niveisIsomagnitude(eclipse.id);
const { anterior, seguinte } = vizinhos(eclipse.id);

const { principal, alternativa, calendario } = dataVigente(eclipse);
const cabecalho = tituloEclipse(eclipse);

// A hora solar media so aparece antes de 1912; basta um territorio para a nota
// fazer sentido.
const usaHoraSolar = TERRITORIOS.some((territorio) => {
  const dados = eclipse.territorios[territorio];
  return dados.visivel && dados.sistema_hora === "hora_solar_media_local";
});

const faixaEstreita = faixa !== null && !faixa.desenhavel_como_area;

// O texto vem nos dois tempos verbais; escolhe-se o que fizer sentido a data em
// que o site e construido. Um eclipse futuro passa a passado sozinho na primeira
// build depois de acontecer.
// Conteudo editorial, escrito a mao e opcional. As seccoes so aparecem quando
// existe ficheiro para este eclipse; ver src/content/LEIAME.md.
const nota = await getEntry("notas", eclipse.id);
const Nota = nota ? (await render(nota)).Content : null;
const galeria = await getEntry("galeria", eclipse.id);

const hoje = new Date().toISOString().slice(0, 10);
const abertura = eclipse.texto_gerado
  ? eclipse.data_gregoriana > hoje
    ? eclipse.texto_gerado.futuro
    : eclipse.texto_gerado.passado
  : null;
---

<Base titulo={cabecalho} descricao={cabecalho}>
  <p class="discreto">
    <a href={caminho("")}>{t("ficha.voltar")}</a>
  </p>

  <h1>{cabecalho}</h1>
  <p class="datas">
    <EtiquetaTipo tipo={eclipse.tipo} />
    <span>
      {dataPorExtenso(principal)}{" "}
      {
        alternativa && (
          <span class="discreto">
            ({dataPorExtenso(alternativa)}, {t("ficha.calendario_gregoriano")})
          </span>
        )
      }
    </span>
  </p>

  {abertura && <p class="abertura">{abertura}</p>}

  {
    calendario === "juliano" && (
      <div class="nota">
        <p>{t("ficha.nota_calendario")}</p>
      </div>
    )
  }
  {
    usaHoraSolar && (
      <div class="nota">
        <p>{t("ficha.nota_hora_solar")}</p>
      </div>
    )
  }
  {
    !eclipse.dados_pesados && (
      <div class="nota">
        <p>{t("ficha.nota_sem_dados_pesados")}</p>
      </div>
    )
  }
  {
    faixaEstreita && (
      <div class="nota">
        <p>
          {t("ficha.nota_faixa_estreita")}
          {faixa?.largura_sobre_pt_km !== null &&
            faixa?.largura_sobre_pt_km !== undefined && (
              <>
                {" "}
                {t("ficha.largura_faixa")}: {numero(faixa.largura_sobre_pt_km, 2)}{" "}
                km.
              </>
            )}
        </p>
      </div>
    )
  }

  <h2>{t("ficha.mapa")}</h2>
  <Mapa
    eclipse={eclipse}
    recursos={recursos}
    municipios={municipios}
    faixa={faixa}
    niveis={niveis}
  />

  <SimulacaoSol eclipse={eclipse} />

  <h2>{t("ficha.circunstancias")}</h2>
  <div class="grelha">
    {
      TERRITORIOS.map((territorio) => {
        const dados = eclipse.territorios[territorio];
        return (
          <section class="caixa">
            <h3>{NOMES_TERRITORIO[territorio]}</h3>
            {dados.visivel ? (
              <dl class="dados">
                <dt>{t("ficha.tipo_local")}</dt>
                <dd>{NOMES_TIPO_LOCAL[dados.tipo_local]}</dd>

                <dt>{t("ficha.magnitude_maxima")}</dt>
                <dd>{magnitude(dados.magnitude_max)}</dd>

                <dt>{t("ficha.obscuracao")}</dt>
                <dd>{percentagem(dados.obscuracao_max)}</dd>

                <dt>{t("ficha.local_mais_fundo")}</dt>
                <dd>{dados.local_mais_fundo.nome}</dd>

                <dt>{t("ficha.maximo_local")}</dt>
                <dd>
                  {horaCurta(dados.maximo_local)}
                  <span class="discreto">
                    {" "}
                    {rotuloSistemaHora(dados.sistema_hora, dados.designacao_fuso)}
                  </span>
                </dd>

                <dt>{t("ficha.maximo_ut")}</dt>
                <dd>{horaCurta(dados.maximo_ut)}</dd>

                <dt>{t("ficha.altura_sol")}</dt>
                <dd>{graus(dados.alt_sol_graus)}</dd>

                <dt>{t("ficha.azimute_sol")}</dt>
                <dd>{graus(dados.az_sol_graus)}</dd>

                {dados.duracao_central_s !== null && (
                  <>
                    <dt>{t("ficha.duracao_central")}</dt>
                    <dd>{duracao(dados.duracao_central_s)}</dd>
                  </>
                )}

                {dados.faixa_entrada && (
                  <>
                    <dt>{t("ficha.faixa_entrada")}</dt>
                    <dd>{dados.faixa_entrada.nome}</dd>
                  </>
                )}

                {dados.faixa_saida && (
                  <>
                    <dt>{t("ficha.faixa_saida")}</dt>
                    <dd>{dados.faixa_saida.nome}</dd>
                  </>
                )}

                {dados.faixa_central && (
                  <>
                    <dt>{t("ficha.area_com_faixa")}</dt>
                    <dd>{percentagem(dados.fraccao_territorio_com_faixa)}</dd>
                  </>
                )}
              </dl>
            ) : (
              <p class="discreto">{t("ficha.nao_visivel")}</p>
            )}
          </section>
        );
      })
    }
  </div>

  {
    municipios && municipios.concelhos.length > 0 && (
      <>
        <h2>{t("ficha.concelhos")}</h2>
        <p class="discreto">
          {t("ficha.concelhos_total", { total: municipios.total })}
        </p>
        <div class="nota">
          <p>{t("ficha.concelhos_aviso")}</p>
        </div>
        <div class="tabela-envolvente">
          <table>
            <thead>
              <tr>
                <th scope="col">{t("ficha.concelhos_coluna_nome")}</th>
                <th scope="col">{t("ficha.concelhos_coluna_tipo")}</th>
                <th scope="col" class="numero">
                  {t("ficha.concelhos_coluna_magnitude")}
                </th>
                <th scope="col" class="numero">
                  {t("ficha.concelhos_coluna_duracao")}
                </th>
                <th scope="col" class="numero">
                  {t("ficha.concelhos_coluna_maximo")}
                </th>
                <th scope="col" class="numero">
                  {t("ficha.concelhos_coluna_area")}
                </th>
              </tr>
            </thead>
            <tbody>
              {municipios.concelhos.map((concelho) => (
                <tr>
                  <th scope="row">{concelho.nome}</th>
                  <td>{NOMES_TIPO_LOCAL[concelho.tipo_local]}</td>
                  <td class="numero">{magnitude(concelho.magnitude)}</td>
                  <td class="numero">
                    {concelho.duracao_central_s === null
                      ? ""
                      : duracao(concelho.duracao_central_s)}
                  </td>
                  <td class="numero">{horaCurta(concelho.maximo_local)}</td>
                  <td class="numero">{percentagem(concelho.fraccao_area, 0)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {
    nota && Nota && (
      <section class="notas">
        <h2>{nota.data.titulo ?? t("ficha.notas")}</h2>
        <div class="prosa">
          <Nota />
        </div>
        {nota.data.fontes && nota.data.fontes.length > 0 && (
          <>
            <h3>{t("ficha.fontes")}</h3>
            <ul class="fontes">
              {nota.data.fontes.map((fonte) => (
                <li>
                  {fonte.url ? <a href={fonte.url}>{fonte.titulo}</a> : fonte.titulo}
                  {fonte.autor && <span>, {fonte.autor}</span>}
                  {fonte.publicacao && <span>, {fonte.publicacao}</span>}
                  {fonte.ano && <span>, {fonte.ano}</span>}
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )
  }

  {
    galeria && (
      <section class="galeria">
        <h2>{t("ficha.galeria")}</h2>
        <div class="imagens">
          {galeria.data.imagens.map((imagem) => {
            const credito = [imagem.autor, imagem.ano, imagem.fonte]
              .filter(Boolean)
              .join(", ");
            return (
              <figure>
                <img
                  src={caminho(`imagens/${eclipse.id}/${imagem.ficheiro}`)}
                  alt={imagem.alternativo ?? imagem.legenda}
                  width={imagem.largura}
                  height={imagem.altura}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  {imagem.legenda}
                  <span class="credito">
                    {credito && <>{credito}. </>}
                    {imagem.url && (
                      <>
                        <a href={imagem.url}>{t("ficha.imagem_origem")}</a>.{" "}
                      </>
                    )}
                    {t("ficha.licenca")}: {imagem.licenca}.
                  </span>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    )
  }

  <h2>{t("ficha.dados_globais")}</h2>
  <dl class="dados dados-globais">
    <dt>{t("ficha.tipo")}</dt>
    <dd>{NOMES_TIPO[eclipse.tipo]}</dd>

    <dt>{t("ficha.saros")}</dt>
    <dd>{eclipse.saros}</dd>

    <dt>{t("ficha.gamma")}</dt>
    <dd>{numero(eclipse.gamma, 4)}</dd>

    <dt>{t("ficha.magnitude_canon")}</dt>
    <dd>{magnitude(eclipse.magnitude_canon)}</dd>

    <dt>{t("ficha.maximo_global")}</dt>
    <dd>{eclipse.maximo_global_ut} UT</dd>

    <dt>{t("ficha.delta_t")}</dt>
    <dd>{numero(eclipse.delta_t_s, 1)} s</dd>

    <dt>{t("ficha.dia_juliano")}</dt>
    <dd>{numero(eclipse.jd, 3)}</dd>

    {
      faixa?.largura_maxima_km !== null && faixa?.largura_maxima_km !== undefined && (
        <>
          <dt>{t("ficha.largura_faixa_maxima")}</dt>
          <dd>{numero(faixa.largura_maxima_km, 1)} km</dd>
        </>
      )
    }
  </dl>

  <nav class="vizinhos" aria-label={t("nav.catalogo")}>
    {
      anterior ? (
        <a href={urlEclipse(anterior.id)}>
          <span class="discreto">{t("ficha.anterior")}</span>
          <br />
          {dataPorExtenso(dataVigente(anterior).principal)}
        </a>
      ) : (
        <span />
      )
    }
    {
      seguinte && (
        <a class="direita" href={urlEclipse(seguinte.id)}>
          <span class="discreto">{t("ficha.seguinte")}</span>
          <br />
          {dataPorExtenso(dataVigente(seguinte).principal)}
        </a>
      )
    }
  </nav>
</Base>

<style>
  .prosa,
  .fontes {
    max-width: 44rem;
  }

  .fontes {
    font-size: 0.95rem;
  }

  .imagens {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .imagens figure {
    margin: 0;
  }

  .imagens img {
    width: 100%;
    height: auto;
    /* Uma gravura estreita e uma fotografia larga tem de caber lado a lado sem
       uma delas dominar a pagina. */
    max-height: 26rem;
    object-fit: contain;
    background: var(--fundo-suave);
    border-radius: var(--raio);
    border: 1px solid var(--linha);
  }

  .imagens figcaption {
    margin-top: 0.4rem;
    font-size: 0.9rem;
  }

  .credito {
    display: block;
    color: var(--texto-suave);
    font-size: 0.82rem;
  }

  .abertura {
    font-family: var(--tipografia);
    font-size: 1.15rem;
    line-height: 1.55;
    max-width: 44rem;
  }

  .datas {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-size: 1.05rem;
    margin-top: 0;
  }

  .dados-globais {
    max-width: 32rem;
  }

  .vizinhos {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--linha);
  }

  .vizinhos .direita {
    text-align: right;
    margin-left: auto;
  }
</style>
