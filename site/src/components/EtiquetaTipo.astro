---
/** O tipo do eclipse, e o que dele se viu de Portugal.
 *
 * As duas coisas nem sempre coincidem, e a diferenca e a informacao mais util
 * que a etiqueta pode dar a quem esta ca: o eclipse de 2 de agosto de 2027 e
 * total, mas de Portugal ve-se parcial. A etiqueta diz o tipo do eclipse, que e
 * o nome por que ele e conhecido, e ao lado diz o que ca se viu quando for
 * outra coisa.
 *
 * Quando os dois coincidem nao se acrescenta nada: repetir "total, total em
 * Portugal" so gastaria a atencao de quem le.
 *
 * Serve as duas familias. As cores dos tipos lunares sao proprias, para uma
 * grelha com Sol e Lua nao dizer a mesma coisa com a mesma cor de coisas
 * diferentes.
 */
import { t } from "../i18n";
import {
  NOMES_TIPO,
  NOMES_TIPO_LOCAL,
  NOMES_TIPO_LOCAL_LUNAR,
  NOMES_TIPO_LUNAR,
} from "../lib/formatacao";
import type {
  Familia,
  TipoEclipse,
  TipoEclipseLunar,
  TipoLocal,
  TipoLocalLunar,
} from "../lib/tipos";

interface Props {
  familia?: Familia;
  tipo: TipoEclipse | TipoEclipseLunar;
  /** O que se viu de Portugal, onde o eclipse foi mais fundo. */
  tipoLocal?: TipoLocal | TipoLocalLunar;
}

const { familia = "solar", tipo, tipoLocal } = Astro.props;
const lunar = familia === "lunar";
const nome = lunar
  ? NOMES_TIPO_LUNAR[tipo as TipoEclipseLunar]
  : NOMES_TIPO[tipo as TipoEclipse];
const nomeLocal =
  tipoLocal === undefined
    ? null
    : lunar
      ? NOMES_TIPO_LOCAL_LUNAR[tipoLocal as TipoLocalLunar]
      : NOMES_TIPO_LOCAL[tipoLocal as TipoLocal];
const prefixo = lunar ? "tipo-lua" : "tipo";
const diferente = tipoLocal !== undefined && tipoLocal !== tipo;
---

<span class="etiqueta-tipo">
  <span class:list={["etiqueta", `${prefixo}-${tipo}`]}>{nome}</span>
  {
    diferente && (
      <span class:list={["local", `${prefixo}-${tipoLocal}`]}>
        {t("lista.tipo_em_portugal", { tipo: nomeLocal!.toLowerCase() })}
      </span>
    )
  }
</span>

<style>
  .etiqueta-tipo {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15rem 0.4rem;
  }

  .local {
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
