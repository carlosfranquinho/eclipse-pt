---
import { t } from "../i18n";
import {
  NOMES_TERRITORIO,
  NOMES_TIPO,
  NOMES_TIPO_LUNAR,
} from "../lib/formatacao";
import type { EntradaCatalogo, Territorio } from "../lib/tipos";
import { periodos } from "../lib/filtros";

interface Props {
  eclipses: EntradaCatalogo[];
}

const { eclipses } = Astro.props;

// A escolha do astro manda no resto do formulario: cada controlo declara em que
// escolhas faz sentido, e os que nao fazem desaparecem, repostos no valor por
// omissao para nao filtrarem as escondidas. Um eclipse lunar nao tem faixa
// central, e "anular" e "penumbral" nao sao tipos da mesma coisa.
const ASTROS = [
  { valor: "ambos", nome: t("filtros.astro_ambos") },
  { valor: "solar", nome: t("filtros.astro_sol") },
  { valor: "lunar", nome: t("filtros.astro_lua") },
];

const tiposSolares = Object.entries(NOMES_TIPO);
const tiposLunares = Object.entries(NOMES_TIPO_LUNAR);

const territorios = Object.keys(NOMES_TERRITORIO) as Territorio[];
const intervalos = periodos(eclipses);

// Quantos eclipses o controlo dos penumbrais governa, contados e nao escritos a
// mao: o numero muda com o intervalo do catalogo.
const lunares = eclipses.filter((e) => e.familia === "lunar");
const penumbrais = lunares.filter(
  (e) => e.familia === "lunar" && e.pt.tipo_local === "penumbral",
).length;
---

<form id="filtros" class="filtros caixa so-com-js" aria-label={t("filtros.titulo")}>
  <fieldset>
    <legend>{t("filtros.astro")}</legend>
    <div class="opcoes">
      {
        ASTROS.map((astro, indice) => (
          <label>
            <input
              type="radio"
              name="familia"
              value={astro.valor}
              checked={indice === 0}
            />
            {astro.nome}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset data-visivel-em="ambos solar">
    <legend>{t("filtros.tipo_sol")}</legend>
    <div class="opcoes">
      {
        tiposSolares.map(([tipo, nome]) => (
          <label>
            <input type="checkbox" name="tipo-sol" value={tipo} />
            {nome}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset data-visivel-em="ambos lunar">
    <legend>{t("filtros.tipo_lua")}</legend>
    <div class="opcoes">
      {
        tiposLunares.map(([tipo, nome]) => (
          <label>
            <input type="checkbox" name="tipo-lua" value={tipo} />
            {nome}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset>
    <legend>{t("filtros.territorio")}</legend>
    <div class="opcoes">
      {
        territorios.map((territorio) => (
          <label>
            <input type="checkbox" name="territorio" value={territorio} />
            {NOMES_TERRITORIO[territorio]}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset>
    <legend>{t("filtros.periodo")}</legend>
    <div class="opcoes">
      <label>
        <input type="radio" name="quando" value="todos" checked />
        {t("filtros.periodo_todos")}
      </label>
      <label>
        <input type="radio" name="quando" value="futuros" />
        {t("filtros.periodo_futuros")}
      </label>
      <label>
        <input type="radio" name="quando" value="passados" />
        {t("filtros.periodo_passados")}
      </label>
    </div>
  </fieldset>

  <div class="campo">
    <label for="filtro-intervalo">{t("filtros.seculo")}</label>
    <select id="filtro-intervalo" name="intervalo">
      <option value="">{t("filtros.seculo_todos")}</option>
      {
        intervalos.map((ano) => (
          <option value={ano}>
            {ano} - {ano + 99}
          </option>
        ))
      }
    </select>
  </div>

  {/* A magnitude mede coisas diferentes nas duas familias, a fraccao do Sol
      tapada pela Lua e a da Lua dentro da umbra da Terra, e por isso so aparece
      quando ha uma familia escolhida. O rotulo muda com ela. */}
  <div class="campo" data-visivel-em="solar lunar" hidden>
    <label
      for="filtro-magnitude"
      data-rotulo-solar={t("filtros.magnitude_minima")}
      data-rotulo-lunar={t("filtros.magnitude_umbral_minima")}
    >
      {t("filtros.magnitude_minima")}
    </label>
    <div class="deslizador">
      <input
        type="range"
        id="filtro-magnitude"
        name="magnitude"
        min="0"
        max="1"
        step="0.05"
        value="0"
      />
      <output id="valor-magnitude" for="filtro-magnitude">0,00</output>
    </div>
  </div>

  <div class="campo campo-largo" data-visivel-em="solar" hidden>
    <label>
      <input type="checkbox" name="faixa" value="1" />
      {t("filtros.faixa_central")}
    </label>
  </div>

  <div class="campo campo-largo" data-visivel-em="ambos lunar">
    <label>
      <input type="checkbox" name="penumbrais" value="1" />
      {t("filtros.penumbrais")}
    </label>
    <p class="ajuda discreto">
      {t("filtros.penumbrais_ajuda", { penumbrais, lunares: lunares.length })}
    </p>
  </div>

  <div class="rodape-filtros">
    <button type="reset">{t("filtros.limpar")}</button>
    <p
      id="contagem-filtros"
      class="discreto"
      role="status"
      data-modelo={t("filtros.resultados")}
    >
    </p>
  </div>
</form>

<p id="sem-resultados" class="nota" hidden>{t("filtros.sem_resultados")}</p>

<script>
  import {
    NOMES_TIPO,
    NOMES_TIPO_LUNAR,
    magnitude as formatarMagnitude,
  } from "../lib/formatacao";
  import { nivelDeMagnitude, nivelLunar } from "../lib/filtros";

  const forma = document.getElementById("filtros") as HTMLFormElement | null;
  const contagem = document.getElementById("contagem-filtros");
  const semResultados = document.getElementById("sem-resultados");

  if (forma && contagem) {
    // A lista e a linha temporal partilham os mesmos data-*, por isso um
    // eclipse aparece aqui tantas vezes quantas as representacoes que tem.
    const elementos = Array.from(
      document.querySelectorAll<HTMLElement>("[data-eclipse]"),
    );
    const total = new Set(elementos.map((el) => el.dataset.eclipse)).size;
    const modelo = contagem.dataset.modelo ?? "{visiveis}/{total}";

    // Os seculos do catalogo. Cada um sabe dizer quantos eclipses lhe restam,
    // fecha-se quando fica vazio, e abre-se quando ha filtro e ele tem alguma
    // coisa: filtrar e ficar a olhar para titulos fechados nao serviria de nada.
    const catalogo = document.querySelector<HTMLElement>(".catalogo");
    const seculos = Array.from(
      document.querySelectorAll<HTMLDetailsElement>("details[data-grupo]"),
    );
    const abertosDeInicio = new Set(
      seculos.filter((seculo) => seculo.open).map((seculo) => seculo.dataset.grupo),
    );
    const contarUm = catalogo?.dataset.contagemUm ?? "1";
    const contarVarios = catalogo?.dataset.contagemVarios ?? "{total}";

    // A grelha da linha temporal tem um quadrado por ano, e nao um por eclipse:
    // a cor de cada quadrado vem do eclipse mais fundo que ali sobreviver ao
    // filtro. Sai daqui e nao do proprio componente porque so aqui se sabe o que
    // esta a passar.
    // Uma grelha por familia, e as celulas de todas indexadas por familia e
    // ano: o mesmo ano tem um quadrado do Sol e outro da Lua, e sao os dois a
    // repintar.
    const blocosDeGrelha = Array.from(
      document.querySelectorAll<HTMLElement>("[data-familia-grelha]"),
    );
    const celulas = new Map<string, HTMLAnchorElement>();
    for (const grelha of document.querySelectorAll<HTMLElement>(
      ".grelha-anos[data-familia]",
    )) {
      const familia = grelha.dataset.familia!;
      for (const celula of grelha.querySelectorAll<HTMLAnchorElement>(
        ".com-eclipse[data-ano]",
      )) {
        celulas.set(`${familia}:${celula.dataset.ano}`, celula);
      }
    }

    interface AnoNaGrelha {
      quantos: number;
      familia: string;
      tipo: string;
      magnitude: number;
      destino: string;
    }

    /** O prefixo de classe e o nome do tipo dependem da familia: as duas tem um
     * tipo chamado "total" e sao coisas diferentes, com cores diferentes. */
    const prefixoDe = (familia: string) =>
      familia === "lunar" ? "tipo-lua" : "tipo";
    const nomeDoTipo = (familia: string, tipo: string) =>
      familia === "lunar"
        ? ((NOMES_TIPO_LUNAR as Record<string, string>)[tipo] ?? tipo)
        : ((NOMES_TIPO as Record<string, string>)[tipo] ?? tipo);

    function pintarGrelha(linhas: HTMLElement[]) {
      const porAno = new Map<string, AnoNaGrelha>();
      for (const linha of linhas) {
        const ano = linha.dataset.ano;
        const familia = linha.dataset.familia;
        if (!ano || !familia) continue;
        const chave = `${familia}:${ano}`;
        const magnitude = Number(linha.dataset.magnitude ?? 0);
        const anterior = porAno.get(chave);
        if (!anterior) {
          porAno.set(chave, {
            quantos: 1,
            familia,
            tipo: linha.dataset.tipo ?? "parcial",
            magnitude,
            destino: linha.querySelector("a")?.getAttribute("href") ?? "",
          });
        } else {
          anterior.quantos += 1;
          if (magnitude > anterior.magnitude) {
            anterior.magnitude = magnitude;
            anterior.tipo = linha.dataset.tipo ?? anterior.tipo;
            anterior.destino =
              linha.querySelector("a")?.getAttribute("href") ?? anterior.destino;
          }
        }
      }

      for (const [chave, celula] of celulas) {
        const dados = porAno.get(chave);
        const ano = chave.split(":")[1];
        if (!dados) {
          celula.className = "ano com-eclipse apagado";
          celula.removeAttribute("title");
          continue;
        }
        const nivel =
          dados.familia === "lunar"
            ? nivelLunar({
                pt: {
                  magnitude_umbral: dados.magnitude,
                  magnitude_penumbral: dados.magnitude,
                },
              })
            : nivelDeMagnitude(dados.magnitude);
        celula.className = `ano com-eclipse ${prefixoDe(dados.familia)}-${dados.tipo} nivel-${nivel}`;
        if (dados.destino) celula.href = dados.destino;
        const contagem =
          dados.quantos === 1
            ? contarUm
            : contarVarios.replace("{total}", String(dados.quantos));
        const nome = nomeDoTipo(dados.familia, dados.tipo);
        // Aqui a magnitude e a da escala comum, cortada em 1: e o unico numero
        // que os atributos do filtro guardam. Na build, onde ha o eclipse
        // inteiro, a dica traz o numero verdadeiro.
        celula.title = `${ano}: ${contagem}, ${nome.toLowerCase()} de magnitude ${formatarMagnitude(dados.magnitude)}`;
      }

      // Uma grelha inteira sem nada e ruido: se o filtro deixou de fora uma das
      // familias, a grelha dela sai da pagina. E um tipo que ficou sem nenhum
      // ano sai da legenda dela, para a legenda dizer o que esta no ecra e nao
      // o que la podia estar.
      const presentes = new Set(
        [...porAno.values()].map((dados) => `${dados.familia}:${dados.tipo}`),
      );
      for (const bloco of blocosDeGrelha) {
        const familia = bloco.dataset.familiaGrelha!;
        const temAlgum = [...presentes].some((chave) =>
          chave.startsWith(`${familia}:`),
        );
        bloco.hidden = !temAlgum;
        for (const item of bloco.querySelectorAll<HTMLElement>(
          "[data-tipo-legenda]",
        )) {
          item.hidden = !presentes.has(`${familia}:${item.dataset.tipoLegenda}`);
        }
      }
    }

    function arrumarSeculos(comFiltro: boolean) {
      // So um seculo fica aberto de cada vez, como fora do filtro: com filtro,
      // abre-se o primeiro que tenha resultados. Abrir todos seria pedir ao
      // browser que desfizesse a exclusividade a seguir, e ficava aberto um
      // qualquer.
      let jaAbriu = false;
      for (const seculo of seculos) {
        const restantes = seculo.querySelectorAll(
          "tbody [data-eclipse]:not([hidden])",
        ).length;

        const contador = seculo.querySelector("[data-contagem-grupo]");
        if (contador) {
          contador.textContent =
            restantes === 1
              ? contarUm
              : contarVarios.replace("{total}", String(restantes));
        }

        seculo.hidden = restantes === 0;
        const deveAbrir = comFiltro
          ? !jaAbriu && restantes > 0
          : abertosDeInicio.has(seculo.dataset.grupo);
        seculo.open = deveAbrir;
        if (deveAbrir) jaAbriu = true;
      }
    }
    // Quantos eclipses ficam a vista sem ninguem mexer em nada. Fixa-se na
    // primeira passagem, que corre com o formulario nos valores por omissao.
    let visiveisPorOmissao: number | null = null;

    // Os controlos que so aparecem para certas escolhas de astro.
    const condicionais = Array.from(
      forma.querySelectorAll<HTMLElement>("[data-visivel-em]"),
    );

    const saidaMagnitude = document.getElementById(
      "valor-magnitude",
    ) as HTMLOutputElement | null;

    // O site e estatico: "por observar" tem de ser medido contra a data de
    // hoje no browser, nao contra a data da build.
    const hoje = new Date().toISOString().slice(0, 10);

    const marcados = (nome: string) =>
      Array.from(
        forma.querySelectorAll<HTMLInputElement>(
          `input[name="${nome}"]:checked`,
        ),
      ).map((entrada) => entrada.value);

    // O astro da passagem anterior, para se saber quando ele muda.
    let astroAnterior: string | null = null;

    /** Mostra os controlos que fazem sentido para o astro escolhido e repoe os
     * outros. Repor e a parte que importa: um controlo escondido com valor
     * dentro continuaria a filtrar, e ninguem perceberia porque. */
    function arrumarControlos(astro: string) {
      const mudouDeAstro = astroAnterior !== null && astroAnterior !== astro;
      astroAnterior = astro;

      // A magnitude nao se herda de uma familia para a outra: 0,70 do disco
      // solar tapado e 0,70 do diametro da Lua dentro da umbra sao criterios
      // diferentes, e arrastar o valor de um para o outro filtrava por uma coisa
      // que ninguem pediu.
      if (mudouDeAstro) {
        const deslizador = forma!.querySelector<HTMLInputElement>(
          "#filtro-magnitude",
        );
        if (deslizador) deslizador.value = deslizador.min;
      }

      for (const campo of condicionais) {
        const mostra = (campo.dataset.visivelEm ?? "").split(" ").includes(astro);
        if (campo.hidden === !mostra) continue;
        campo.hidden = !mostra;
        if (mostra) continue;
        for (const entrada of campo.querySelectorAll<HTMLInputElement>("input")) {
          if (entrada.type === "checkbox" || entrada.type === "radio") {
            entrada.checked = entrada.defaultChecked;
          } else if (entrada.type === "range") {
            entrada.value = entrada.min;
          }
        }
      }

      // O deslizador da magnitude serve as duas familias e mede coisas
      // diferentes em cada uma; o rotulo tem de o dizer.
      const rotulo = forma!.querySelector<HTMLLabelElement>(
        'label[for="filtro-magnitude"]',
      );
      if (rotulo && astro !== "ambos") {
        rotulo.textContent =
          astro === "lunar"
            ? (rotulo.dataset.rotuloLunar ?? rotulo.textContent)
            : (rotulo.dataset.rotuloSolar ?? rotulo.textContent);
      }
    }

    function aplicar() {
      const astro = String(
        new FormData(forma!).get("familia") ?? "ambos",
      );
      arrumarControlos(astro);

      const dados = new FormData(forma!);
      const tiposSolares = marcados("tipo-sol");
      const tiposLunares = marcados("tipo-lua");
      const territorios = marcados("territorio");
      const intervalo = String(dados.get("intervalo") ?? "");
      const magnitudeMinima = Number(dados.get("magnitude") ?? 0);
      const soFaixa = dados.get("faixa") === "1";
      // Quem pede o tipo "penumbral" na lista dos tipos da Lua esta a pedi-los,
      // e seria absurdo devolver-lhe uma lista vazia por causa de uma omissao.
      const mostrarPenumbrais =
        dados.get("penumbrais") === "1" || tiposLunares.includes("penumbral");
      const quando = String(dados.get("quando") ?? "todos");

      const visiveis = new Set<string>();
      const linhasVisiveis: HTMLElement[] = [];
      for (const elemento of elementos) {
        const d = elemento.dataset;
        const territoriosDoEclipse = (d.territorios ?? "").split(" ");
        // Cada familia responde a sua lista de tipos. Sem isto, "total" pedia
        // os totais das duas, que sao coisas diferentes com o mesmo nome.
        const tiposDaFamilia =
          d.familia === "lunar" ? tiposLunares : tiposSolares;
        const passa =
          (astro === "ambos" || d.familia === astro) &&
          (tiposDaFamilia.length === 0 ||
            tiposDaFamilia.includes(d.tipo ?? "")) &&
          (territorios.length === 0 ||
            territorios.some((territorio) =>
              territoriosDoEclipse.includes(territorio),
            )) &&
          (intervalo === "" || d.periodo === intervalo) &&
          (mostrarPenumbrais || d.penumbral !== "1") &&
          Number(d.magnitude ?? 0) >= magnitudeMinima &&
          (!soFaixa || d.faixa === "1") &&
          (quando === "todos" ||
            (quando === "futuros"
              ? (d.data ?? "") >= hoje
              : (d.data ?? "") < hoje));

        elemento.hidden = !passa;
        if (passa && d.eclipse) {
          visiveis.add(d.eclipse);
          linhasVisiveis.push(elemento);
        }
      }

      pintarGrelha(linhasVisiveis);

      // O que conta como "ha filtro" e o leitor ter mexido em alguma coisa, e
      // nao haver eclipses escondidos: os penumbrais comecam escondidos, e sem
      // esta medida o catalogo abria logo no seculo XVI em vez de abrir naquele
      // em que estamos.
      if (visiveisPorOmissao === null) visiveisPorOmissao = visiveis.size;
      arrumarSeculos(visiveis.size < visiveisPorOmissao);

      contagem!.textContent = modelo
        .replace("{visiveis}", String(visiveis.size))
        .replace("{total}", String(total));
      if (semResultados) semResultados.hidden = visiveis.size > 0;
      if (saidaMagnitude) {
        saidaMagnitude.textContent = magnitudeMinima.toLocaleString("pt-PT", {
          minimumFractionDigits: 2,
        });
      }
    }

    forma.addEventListener("input", aplicar);
    // O reset repoe os campos depois do evento, por isso espera-se um tick.
    forma.addEventListener("reset", () => window.setTimeout(aplicar, 0));
    aplicar();
  }
</script>

<style>
  .filtros {
    display: grid;
    gap: 1rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin-bottom: 1.5rem;
    font-size: 0.92rem;
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  legend,
  .campo > label {
    padding: 0;
    color: var(--texto-suave);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .opcoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
  }

  .campo-largo {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  /* O `hidden` do HTML vale por um `display: none` da folha do browser, e
     qualquer regra nossa que declare `display` ganha-lhe. Sem isto, os
     controlos escondidos por nao fazerem sentido continuavam a ver-se. */
  .filtros [hidden] {
    display: none;
  }

  .campo-largo .ajuda {
    margin: 0.1rem 0 0;
    font-size: 0.82rem;
  }

  .opcoes label,
  .campo-largo label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-transform: none;
    letter-spacing: normal;
    font-size: 0.92rem;
    color: var(--texto);
    margin: 0;
  }

  select {
    width: 100%;
    padding: 0.3rem 0.4rem;
    background: var(--fundo);
    color: var(--texto);
    border: 1px solid var(--linha);
    border-radius: 0.3rem;
    font: inherit;
  }

  .deslizador {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .deslizador input {
    flex: 1;
    accent-color: var(--realce);
  }

  output {
    font-variant-numeric: tabular-nums;
    min-width: 2.5rem;
  }

  .rodape-filtros {
    display: flex;
    align-items: center;
    gap: 1rem;
    grid-column: 1 / -1;
  }

  .rodape-filtros p {
    margin: 0;
  }

  button {
    font: inherit;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--linha);
    border-radius: 0.3rem;
    background: var(--fundo-suave);
    color: var(--texto);
    cursor: pointer;
  }

  button:hover {
    border-color: var(--realce);
  }
</style>
