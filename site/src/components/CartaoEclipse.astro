---
import EtiquetaTipo from "./EtiquetaTipo.astro";
import { t } from "../i18n";
import {
  NOMES_TERRITORIO,
  dataPorExtenso,
  dataVigente,
  magnitude,
} from "../lib/formatacao";
import type { EntradaCatalogo } from "../lib/tipos";
import { urlDeEntrada } from "../lib/urls";

interface Props {
  eclipse: EntradaCatalogo;
}

const { eclipse } = Astro.props;
const { principal } = dataVigente(eclipse);
const territorios = eclipse.pt.territorios_visiveis
  .map((territorio) => NOMES_TERRITORIO[territorio])
  .join(", ");
---

<article class="caixa cartao">
  <p class="astro discreto">
    {eclipse.familia === "lunar" ? t("cartao.da_lua") : t("cartao.do_sol")}
  </p>
  <EtiquetaTipo
    familia={eclipse.familia}
    tipo={eclipse.tipo}
    tipoLocal={eclipse.pt.tipo_local}
  />
  <h3>
    <a href={urlDeEntrada(eclipse)}>{dataPorExtenso(principal)}</a>
  </h3>
  <dl class="dados">
    {
      eclipse.familia === "solar" ? (
        <>
          <dt>{t("ficha.magnitude_maxima")}</dt>
          <dd>{magnitude(eclipse.pt.magnitude_max)}</dd>
        </>
      ) : (
        <>
          <dt>{t("ficha.magnitude_umbral")}</dt>
          <dd>
            {eclipse.pt.magnitude_umbral > 0
              ? magnitude(eclipse.pt.magnitude_umbral)
              : t("ficha.sem_umbra")}
          </dd>
        </>
      )
    }
    <dt>{t("lista.territorios")}</dt>
    <dd>{territorios}</dd>
    {
      eclipse.familia === "solar" && eclipse.pt.faixa_central && (
        <>
          <dt>{t("lista.faixa_central")}</dt>
          <dd>{t("lista.sim")}</dd>
        </>
      )
    }
  </dl>
</article>

<style>
  .astro {
    margin: 0 0 0.3rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .cartao h3 {
    margin: 0.4rem 0 0.6rem;
    font-size: 1.15rem;
  }

  .cartao h3 a {
    text-decoration: none;
  }

  .cartao h3 a:hover {
    text-decoration: underline;
  }
</style>
