:2.3,"nasceu_eclipsada":false,"poe_se_eclipsada":true,"por":{"jd_ut":2614661.778672,"hora_local":"06:41:17","data_local":"2446-08-07","sistema_hora":"hora_legal","designacao_fuso":"+00","hora_ut":"06:41:17","altura_graus":0.5,"azimute_graus":246.9,"acima_do_horizonte":true}},"madeira":{"visivel":false,"lugar":{"nome":"Funchal","lat":32.6669,"lon":-16.9241}}},"elementos":{"jd_maximo_td":2614661.88825231,"delta_t_s":1233.0,"raio_umbra":0.7399519,"raio_penumbra":1.26522659,"raio_lua":0.2698259,"y":-0.69268395,"velocidade":0.55742886},"texto_gerado":{"passado":"Ao amanhecer de 7 de agosto de 2446 houve um eclipse parcial da Lua. Daqui, a fase que se chegou a ver foi apenas penumbral. Em Ponta Delgada, a Lua atravessou apenas a orla exterior da penumbra, um escurecimento que a olho nu não se distingue de uma noite qualquer. A Lua pôs-se às 06:41, ainda eclipsada, e escondeu o resto do eclipse. No continente não foi visível. Na Madeira não foi visível.","futuro":"Ao amanhecer de 7 de agosto de 2446 haverá um eclipse parcial da Lua. Daqui, a fase que se chegará a ver será apenas penumbral. Em Ponta Delgada, a Lua atravessará apenas a orla exterior da penumbra, um escurecimento que a olho nu não se distingue de uma noite qualquer. A Lua pôr-se-á às 06:41, ainda eclipsada, e esconderá o resto do eclipse. No continente não será visível. Na Madeira não será visível."}}