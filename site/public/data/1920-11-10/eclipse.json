011454,4e-06,0.0],"mu":[63.998379,15.00025,0.0,0.0],"l1":[0.565419,9.97e-05,-1.04e-05,0.0],"l2":[0.019185,9.93e-05,-1.04e-05,0.0],"tan_f1":0.0047242,"tan_f2":0.0047007,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"A meio da tarde de 10 de novembro de 1920, um eclipse parcial do Sol cobriu parte do disco solar visto de Portugal. Em Corvo, onde foi mais fundo, a Lua chegou a cobrir 39 por cento do disco solar, com o Sol a 22 graus acima do horizonte. No continente o máximo foi de 34 por cento do disco coberto. Na Madeira o máximo foi de 21 por cento do disco coberto.","futuro":"A meio da tarde de 10 de novembro de 1920, um eclipse parcial do Sol cobrirá parte do disco solar visto de Portugal. Em Corvo, onde será mais fundo, a Lua chegará a cobrir 39 por cento do disco solar, com o Sol a 22 graus acima do horizonte. No continente o máximo será de 34 por cento do disco coberto. Na Madeira o máximo será de 21 por cento do disco coberto."}}