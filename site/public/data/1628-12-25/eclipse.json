-0.0335751,0.0001316,5e-07],"d":[-23.4131298,0.001516,6e-06,0.0],"mu":[44.66888,14.99614,0.0,0.0],"l1":[0.575234,2.89e-05,-9.9e-06,0.0],"l2":[0.028951,2.87e-05,-9.9e-06,0.0],"tan_f1":0.0047571,"tan_f2":0.0047334,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"A meio da tarde de 25 de dezembro de 1628 houve um eclipse anular do Sol, visto de Portugal como um eclipse parcial. O máximo foi em Funchal, com 71 por cento do Sol coberto e o astro a 19 graus acima do horizonte. No continente o máximo foi de 63 por cento do disco coberto. Nos Açores o máximo foi de 48 por cento do disco coberto.","futuro":"A meio da tarde de 25 de dezembro de 1628 haverá um eclipse anular do Sol, visto de Portugal como um eclipse parcial. O máximo será em Funchal, com 71 por cento do Sol coberto e o astro a 19 graus acima do horizonte. No continente o máximo será de 63 por cento do disco coberto. Nos Açores o máximo será de 48 por cento do disco coberto."}}