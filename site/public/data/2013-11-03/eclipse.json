757,7.9e-05,1.7e-06],"d":[-15.2096596,-0.012636,3e-06,0.0],"mu":[19.11059,15.00132,0.0,0.0],"l1":[0.546282,-0.0001121,-1.2e-05,0.0],"l2":[0.000143,-0.0001115,-1.2e-05,0.0],"tan_f1":0.0047137,"tan_f2":0.0046902,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"Por volta do meio-dia de 3 de novembro de 2013 houve um eclipse híbrido do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde foi mais fundo, a Lua chegou a cobrir 27 por cento do disco solar, com o Sol a 44 graus acima do horizonte. No continente o máximo foi de 9 por cento do disco coberto. Nos Açores o máximo foi de 24 por cento do disco coberto.","futuro":"Por volta do meio-dia de 3 de novembro de 2013 haverá um eclipse híbrido do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde será mais fundo, a Lua chegará a cobrir 27 por cento do disco solar, com o Sol a 44 graus acima do horizonte. No continente o máximo será de 9 por cento do disco coberto. Nos Açores o máximo será de 24 por cento do disco coberto."}}