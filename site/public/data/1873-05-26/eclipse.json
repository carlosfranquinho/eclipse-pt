"d":[21.16749,0.006822,-5e-06,0.0],"mu":[315.812042,15.00023,0.0,0.0],"l1":[0.548952,0.0001209,-1.11e-05,0.0],"l2":[0.0028,0.0001203,-1.1e-05,0.0],"tan_f1":0.0046132,"tan_f2":0.0045902,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"Ao amanhecer de 26 de maio de 1873 houve um eclipse parcial do Sol, visto de Portugal como um eclipse parcial. Em Corvo, onde foi mais fundo, a Lua chegou a cobrir 39 por cento do disco solar, com o Sol a 13 graus acima do horizonte. No continente o máximo foi de 20 por cento do disco coberto. Na Madeira o máximo foi de 16 por cento do disco coberto.","futuro":"Ao amanhecer de 26 de maio de 1873 haverá um eclipse parcial do Sol, visto de Portugal como um eclipse parcial. Em Corvo, onde será mais fundo, a Lua chegará a cobrir 39 por cento do disco solar, com o Sol a 13 graus acima do horizonte. No continente o máximo será de 20 por cento do disco coberto. Na Madeira o máximo será de 16 por cento do disco coberto."}}