mu":[57.91206,15.00404,0.0,0.0],"l1":[0.568085,7.14e-05,-1.01e-05,0.0],"l2":[0.021838,7.11e-05,-1.01e-05,0.0],"tan_f1":0.0047072,"tan_f2":0.0046837,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"Ao fim da tarde de 16 de março de 2295, um eclipse anular do Sol cobriu parte do disco solar visto de Portugal. Em Funchal, onde foi mais fundo, a Lua chegou a cobrir 36 por cento do disco solar, com o Sol a 21 graus acima do horizonte. No continente o máximo foi de 20 por cento do disco coberto. Nos Açores o máximo foi de 13 por cento do disco coberto.","futuro":"Ao fim da tarde de 16 de março de 2295, um eclipse anular do Sol cobrirá parte do disco solar visto de Portugal. Em Funchal, onde será mais fundo, a Lua chegará a cobrir 36 por cento do disco solar, com o Sol a 21 graus acima do horizonte. No continente o máximo será de 20 por cento do disco coberto. Nos Açores o máximo será de 13 por cento do disco coberto."}}