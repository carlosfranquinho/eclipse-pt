-0.014486,-2e-06,0.0],"mu":[14.95947,15.00438,0.0,0.0],"l1":[0.557814,-0.0001057,-1.05e-05,0.0],"l2":[0.011619,-0.0001052,-1.04e-05,0.0],"tan_f1":0.0046337,"tan_f2":0.0046107,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"Por volta do meio-dia de 1 de setembro de 1951, um eclipse anular do Sol cobriu parte do disco solar visto de Portugal. Em Funchal, onde foi mais fundo, a Lua chegou a cobrir 80 por cento do disco solar, com o Sol a 65 graus acima do horizonte. No continente o máximo foi de 47 por cento do disco coberto. Nos Açores o máximo foi de 76 por cento do disco coberto.","futuro":"Por volta do meio-dia de 1 de setembro de 1951, um eclipse anular do Sol cobrirá parte do disco solar visto de Portugal. Em Funchal, onde será mais fundo, a Lua chegará a cobrir 80 por cento do disco solar, com o Sol a 65 graus acima do horizonte. No continente o máximo será de 47 por cento do disco coberto. Nos Açores o máximo será de 76 por cento do disco coberto."}}