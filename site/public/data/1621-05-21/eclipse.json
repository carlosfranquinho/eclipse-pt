ntral_s":null,"fraccao_territorio_com_faixa":0.0}},"dados_pesados":true,"elementos":{"t0_td":9.0,"x":[-0.021181,0.5356795,3.34e-05,-7.2e-06],"y":[0.684753,0.0608788,-0.0001583,-8e-07],"d":[20.2460594,0.008277,-5e-06,0.0],"mu":[316.026611,15.00078,0.0,0.0],"l1":[0.550531,-0.000123,-1.1e-05,0.0],"l2":[0.004371,-0.0001224,-1.09e-05,0.0],"tan_f1":0.0046135,"tan_f2":0.0045905,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"Ao amanhecer de 21 de maio de 1621, a faixa de anularidade de um eclipse anular do Sol atravessou território português, nos Açores. Em Angra do Heroísmo, onde foi mais fundo, o anel de luz durou 48 segundos, com o Sol a 10 graus acima do horizonte. A faixa passou por Lajes do Pico e por Velas, atravessando 8 concelhos. No continente o máximo foi de 86 por cento do disco coberto. Na Madeira o máximo foi de 74 por cento do disco coberto.","futuro":"Ao amanhecer de 21 de maio de 1621, a faixa de anularidade de um eclipse anular do Sol atravessará território português, nos Açores. Em Angra do Heroísmo, onde será mais fundo, o anel de luz durará 48 segundos, com o Sol a 10 graus acima do horizonte. A faixa passará por Lajes do Pico e por Velas, atravessando 8 concelhos. No continente o máximo será de 86 por cento do disco coberto. Na Madeira o máximo será de 74 por cento do disco coberto."}}