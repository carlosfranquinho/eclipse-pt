-2e-07],"d":[22.0243092,0.005649,-5e-06,0.0],"mu":[30.546181,14.99974,0.0,0.0],"l1":[0.561227,8.05e-05,-1.01e-05,0.0],"l2":[0.015014,8.01e-05,-1e-05,0.0],"tan_f1":0.0046123,"tan_f2":0.0045894,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"A meio da tarde de 31 de maio de 2049 houve um eclipse anular do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde foi mais fundo, a Lua chegou a cobrir 40 por cento do disco solar, com o Sol a 67 graus acima do horizonte. No continente o máximo foi de 16 por cento do disco coberto. Nos Açores o máximo foi de 21 por cento do disco coberto.","futuro":"A meio da tarde de 31 de maio de 2049 haverá um eclipse anular do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde será mais fundo, a Lua chegará a cobrir 40 por cento do disco solar, com o Sol a 67 graus acima do horizonte. No continente o máximo será de 16 por cento do disco coberto. Nos Açores o máximo será de 21 por cento do disco coberto."}}