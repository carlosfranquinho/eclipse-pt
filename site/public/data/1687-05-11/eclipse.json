,-0.0001115,-2.9e-06],"d":[17.9974499,0.010152,-4e-06,0.0],"mu":[16.02844,15.00164,0.0,0.0],"l1":[0.548223,0.0001108,-1.12e-05,0.0],"l2":[0.002075,0.0001103,-1.12e-05,0.0],"tan_f1":0.004623,"tan_f2":0.0045999,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"Na manhã de 11 de maio de 1687 houve um eclipse híbrido do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde foi mais fundo, a Lua chegou a cobrir 36 por cento do disco solar, com o Sol a 78 graus acima do horizonte. No continente o máximo foi de 28 por cento do disco coberto. Nos Açores o máximo foi de 8 por cento do disco coberto.","futuro":"Na manhã de 11 de maio de 1687 haverá um eclipse híbrido do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde será mais fundo, a Lua chegará a cobrir 36 por cento do disco solar, com o Sol a 78 graus acima do horizonte. No continente o máximo será de 28 por cento do disco coberto. Nos Açores o máximo será de 8 por cento do disco coberto."}}