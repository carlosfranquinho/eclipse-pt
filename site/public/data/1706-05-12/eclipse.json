9857,0.5388964,3.53e-05,-8.8e-06],"y":[0.644206,0.2055388,-0.0001529,-3.5e-06],"d":[18.06493,0.010071,-4e-06,0.0],"mu":[331.02536,15.00168,0.0,0.0],"l1":[0.534544,5.72e-05,-1.25e-05,0.0],"l2":[-0.011536,5.69e-05,-1.25e-05,0.0],"tan_f1":0.0046225,"tan_f2":0.0045994,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"Na manhã de 12 de maio de 1706 houve um eclipse total do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde foi mais fundo, a Lua chegou a cobrir 97 por cento do disco solar, com o Sol a 29 graus acima do horizonte. No continente o máximo foi de 97 por cento do disco coberto. Nos Açores o máximo foi de 70 por cento do disco coberto.","futuro":"Na manhã de 12 de maio de 1706 haverá um eclipse total do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde será mais fundo, a Lua chegará a cobrir 97 por cento do disco solar, com o Sol a 29 graus acima do horizonte. No continente o máximo será de 97 por cento do disco coberto. Nos Açores o máximo será de 70 por cento do disco coberto."}}