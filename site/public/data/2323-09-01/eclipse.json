46,-2e-06,0.0],"mu":[74.845757,15.00447,0.0,0.0],"l1":[0.561695,-7.44e-05,-1.01e-05,0.0],"l2":[0.01548,-7.41e-05,-1.01e-05,0.0],"tan_f1":0.0046278,"tan_f2":0.0046047,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"Ao fim da tarde de 1 de setembro de 2323 houve um eclipse anular do Sol, visto de Portugal como um eclipse parcial. Em Lajes das Flores, onde foi mais fundo, a Lua chegou a cobrir 60 por cento do disco solar, com o Sol a 32 graus acima do horizonte. No continente o máximo foi de 43 por cento do disco coberto. Na Madeira o máximo foi de 57 por cento do disco coberto.","futuro":"Ao fim da tarde de 1 de setembro de 2323 haverá um eclipse anular do Sol, visto de Portugal como um eclipse parcial. Em Lajes das Flores, onde será mais fundo, a Lua chegará a cobrir 60 por cento do disco solar, com o Sol a 32 graus acima do horizonte. No continente o máximo será de 43 por cento do disco coberto. Na Madeira o máximo será de 57 por cento do disco coberto."}}