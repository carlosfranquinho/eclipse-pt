8969,5e-06,0.0],"mu":[48.491749,14.99862,0.0,0.0],"l1":[0.574299,1.63e-05,-9.8e-06,0.0],"l2":[0.028021,1.63e-05,-9.8e-06,0.0],"tan_f1":0.004736,"tan_f2":0.0047124,"k1":0.272488,"k2":0.272281},"texto_gerado":{"passado":"A meio da tarde de 22 de novembro de 1919 houve um eclipse anular do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde foi mais fundo, a Lua chegou a cobrir 40 por cento do disco solar, com o Sol a 16 graus acima do horizonte. No continente o máximo foi de 32 por cento do disco coberto. Nos Açores o máximo foi de 22 por cento do disco coberto.","futuro":"A meio da tarde de 22 de novembro de 1919 haverá um eclipse anular do Sol, visto de Portugal como um eclipse parcial. Em Funchal, onde será mais fundo, a Lua chegará a cobrir 40 por cento do disco solar, com o Sol a 16 graus acima do horizonte. No continente o máximo será de 32 por cento do disco coberto. Nos Açores o máximo será de 22 por cento do disco coberto."}}